{
  "name": "pressroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43127 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 43127 --hostname 0.0.0.0",
    "lint": "eslint",
    "etsy-tunnel": "bash scripts/etsy-tunnel.sh",
    "desk": "bash scripts/public-desk.sh",
    "apparel-prints": "python3 scripts/make-apparel-prints.py",
    "print-files": "python3 scripts/make-apparel-prints.py && python3 scripts/match-prints-from-mockups.py",
    "print-match": "python3 scripts/match-prints-from-mockups.py",
    "attach-prints": "python3 scripts/attach-gelato-prints.py",
    "test": "node --experimental-strip-types --test src/lib/catalog-sku.test.ts src/lib/shop.test.ts src/lib/shop-currency.test.ts src/lib/meta-ads.test.ts src/lib/printify.test.ts src/lib/print-supplier.test.ts src/lib/drop.test.ts src/lib/listing-health.test.ts && python3 scripts/match-prints-from-mockups.py --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
